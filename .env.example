# Postgres with the pgvector extension available.
# Pooled (pgbouncer) connection — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/repo_chat?sslmode=require&pgbouncer=true"
# Direct, unpooled connection — used by `prisma migrate`, which needs session
# features that the pooler strips.
DATABASE_DIRECT_URL="postgresql://user:password@host:5432/repo_chat?sslmode=require"

# Answer generation — Claude via the Vercel AI SDK.
ANTHROPIC_API_KEY=

# Embeddings provider — must output 4096-dim vectors to match Chunk.embedding.
# The URL and model are not secrets, so they carry their real values and document
# which provider the schema width comes from. The key is an `nvapi-...` secret and
# stays empty here — put the real one in .env, which is gitignored.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDINGS_MODEL=nvidia/nv-embedcode-7b-v1

# Optional. Unauthenticated GitHub API access is capped at 60 requests/hour,
# which is not enough to index a repo of any size.
GITHUB_TOKEN=
