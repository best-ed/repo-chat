# Postgres with the pgvector extension available.
# schema.prisma declares only `url`, no `directUrl`, so this must be a DIRECT
# (non-pooled) connection string — pgbouncer breaks `prisma migrate`.
DATABASE_URL="postgresql://user:password@host:5432/repo_chat?sslmode=require"

# Answer generation — Claude via the Vercel AI SDK.
ANTHROPIC_API_KEY=""

# Embeddings. Chunk.embedding is vector(1536), which is the dimensionality of
# OpenAI text-embedding-3-small. Claude has no embeddings endpoint, so indexing
# needs a second provider.
OPENAI_API_KEY=""

# Optional. Unauthenticated GitHub API access is capped at 60 requests/hour,
# which is not enough to index a repo of any size.
GITHUB_TOKEN=""
